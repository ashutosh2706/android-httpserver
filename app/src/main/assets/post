<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>HTTP Server - Upload</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #e1f5fe;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .center-box {
            text-align: center;
            padding: 30px 20px;
            width: 100%;
            max-width: 400px;
            border-radius: 12px;
            background-color: #ffffff;
        }

        .emoji {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .app-label {
            padding: 10px 0 20px 0;
            color: #0288d1;
        }

        .btn-custom {
            background-color: #03a9f4;
            border-radius: 30px;
            width: 100%;
        }

        .btn-custom:hover {
            background-color: #0288d1;
        }

        .drop-area {
            border: 2px dashed #03a9f4;
            border-radius: 12px;
            padding: 25px;
            cursor: pointer;
            margin-bottom: 20px;
            transition: background-color 0.2s, border-color 0.2s;
        }

        .drop-area:hover {
            background-color: #e1f5fe;
        }

        .drop-area.active {
            background-color: #b3e5fc;
            border-color: #0288d1;
        }

        .file-name {
            margin-top: 10px;
            font-size: 1.3em;
            color: #000;
        }

        .progress {
            display: none;
            margin-top: 20px;
        }

        #toast-container {
            top: 20px !important;
            right: 50% !important;
            transform: translateX(50%);
            left: auto !important;
        }

        .status-box {
            margin-top: 15px;
            font-size: 0.95em;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .status-success {
            color: #2e7d32;
        }

        .status-error {
            color: #d32f2f;
        }
    </style>
</head>

<body>

<div class="center-box z-depth-2">
    <div class="emoji">📤</div>
    <h5 class="app-label">Upload File</h5>

    <div id="dropArea" class="drop-area">
        <p id="dropText">Drag & Drop file here<br>or click to choose</p>
        <input type="file" id="fileInput" style="display: none;">
        <div id="fileName" class="file-name"></div>
        <div id="statusBox" class="status-box" style="display: none;">
            <span id="statusIcon"></span>
            <span id="statusText"></span>
        </div>
    </div>

    <button id="uploadBtn" class="btn btn-custom waves-effect waves-light">
        Upload
    </button>

    <div class="progress" id="progressBar">
        <div class="determinate" id="progressFill" style="width: 0%"></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

<script>
const dropArea = document.getElementById("dropArea");
const fileInput = document.getElementById("fileInput");
const fileNameDisplay = document.getElementById("fileName");
const dropText = document.getElementById("dropText");
const statusBox = document.getElementById("statusBox");
const statusIcon = document.getElementById("statusIcon");
const statusText = document.getElementById("statusText");


let selectedFile = null;

dropArea.addEventListener("click", () => fileInput.click());

fileInput.addEventListener("change", () => {
    statusBox.style.display = "none";
    statusText.textContent = "";
    statusIcon.textContent = "";
    if (fileInput.files.length > 0) {
        selectedFile = fileInput.files[0];
        fileNameDisplay.textContent = selectedFile.name;
        dropText.style.display = "none"; // hide message
    }
});

dropArea.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropArea.classList.add("active");
});

dropArea.addEventListener("dragleave", () => {
    dropArea.classList.remove("active");
});

dropArea.addEventListener("drop", (e) => {
    e.preventDefault();
    dropArea.classList.remove("active");
    statusBox.style.display = "none";
    statusText.textContent = "";
    statusIcon.textContent = "";

    const files = e.dataTransfer.files;
    if (files.length > 0) {
        selectedFile = files[0];
        fileInput.files = files;
        fileNameDisplay.textContent = selectedFile.name;
        dropText.style.display = "none"; // hide message
    }
});

document.getElementById("uploadBtn").addEventListener("click", function () {
    if (!selectedFile) {
        M.toast({ html: "Please select a file" });
        return;
    }

    const formData = new FormData();
    formData.append("file", selectedFile);

    const xhr = new XMLHttpRequest();
    xhr.open("POST", "/upload/", true);

    const progressBar = document.getElementById("progressBar");
    const progressFill = document.getElementById("progressFill");
    progressBar.style.display = "block";

    xhr.upload.onprogress = function (event) {
        if (event.lengthComputable) {
            const percent = (event.loaded / event.total) * 100;
            progressFill.style.width = percent + "%";
        }
    };

    xhr.onload = function () {
        progressFill.style.width = "0%";
        progressBar.style.display = "none";
        statusBox.style.display = "flex";

        if (xhr.status === 200) {
            M.toast({ html: "Upload successful!" });
            statusBox.className = "status-box status-success";
            statusIcon.textContent = "✔";
               statusText.textContent = "Upload successful";
        } else {
            M.toast({ html: "Upload failed!" });
            statusBox.className = "status-box status-error";
            statusIcon.textContent = "❌ " + (xhr.status || "");
            statusText.textContent = xhr.responseText || "Upload failed";
        }

    };

    xhr.onerror = function () {
        M.toast({ html: "Error uploading file" });
        progressFill.style.width = "0%";
        progressBar.style.display = "none";
        statusBox.style.display = "flex";
        statusBox.className = "status-box status-error";
        statusIcon.textContent = "✖ " + (xhr.status || "");
        statusText.textContent = "Error during upload";
    };

    xhr.send(formData);
});
</script>

</body>
</html>