<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/layout_primary_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Header Title -->
        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/http_server"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_foreground"
            android:gravity="center"
            android:letterSpacing="0.02"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/header_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Share files over your local network"
            android:textSize="14sp"
            android:textColor="@color/text_secondary_foreground"
            android:gravity="center"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/header_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Folder Selection Card -->
        <LinearLayout
            android:id="@+id/folder_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/folder_card_bg"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/header_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:textSize="24sp"
                android:layout_marginEnd="12dp"
                app:drawableStartCompat="@drawable/ic_folder_custom" />

            <TextView
                android:id="@+id/file_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:hint="@string/choose_file"
                android:textSize="15sp"
                android:textColor="@color/text_primary_foreground"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- QR Code Card -->
        <LinearLayout
            android:id="@+id/qr_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/qr_card_bg"
            app:layout_constraintTop_toBottomOf="@id/folder_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/qr_view"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_round_wifi" />

            <TextView
                android:id="@+id/ip_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="monospace"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/text_primary_foreground"
                android:paddingTop="16dp" />

        </LinearLayout>

        <!-- Start/Stop Button -->
        <Button
            android:id="@+id/server_btn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="40dp"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:letterSpacing="0.03"
            android:text="@string/start_server"
            android:textColor="@color/white"
            android:background="@drawable/start_server_btn_bg"
            app:layout_constraintTop_toBottomOf="@id/qr_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hidden picker_btn kept for compatibility -->
        <Button
            android:id="@+id/picker_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
